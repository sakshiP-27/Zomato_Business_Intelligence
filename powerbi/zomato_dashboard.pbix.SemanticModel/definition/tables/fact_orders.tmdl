	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "analytical_base_table.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Removed = Table.RemoveColumns(Promoted, {"review", "city_lat", "city_lon", "tenure_is_negative"}, MissingField.Ignore),
				    Typed = Table.TransformColumnTypes(Removed, {{"order_id", type text}, {"customer_id", type text}, {"restaurant_id", type text}, {"delivery_partner_id", type text}, {"order_date", type date}, {"order_time", type text}, {"delivery_time_minutes", type number}, {"food_cost", type number}, {"delivery_fee", type number}, {"discount", type number}, {"coupon_code", type text}, {"gst", type number}, {"final_amount", type number}, {"order_status", type text}, {"payment_method", type text}, {"dt_outlier_flag", Int64.Type}, {"customer_name", type text}, {"customer_age", Int64.Type}, {"customer_gender", type text}, {"customer_city", type text}, {"state", type text}, {"membership", type text}, {"registration_date", type date}, {"total_orders", Int64.Type}, {"preferred_cuisine", type text}, {"restaurant_name", type text}, {"restaurant_cuisine", type text}, {"restaurant_city", type text}, {"area", type text}, {"restaurant_rating", type number}, {"average_cost", type number}, {"restaurant_type", type text}, {"latitude", type number}, {"longitude", type number}, {"partner_name", type text}, {"partner_age", Int64.Type}, {"partner_gender", type text}, {"vehicle_type", type text}, {"joining_date", type date}, {"partner_city", type text}, {"partner_rating", type number}, {"completed_deliveries", Int64.Type}, {"partner_avg_delivery_time", type number}, {"discount_percentage", Int64.Type}, {"campaign_name", type text}, {"n_items", Int64.Type}, {"n_distinct_items", Int64.Type}, {"basket_value", type number}, {"avg_prep_time", type number}, {"max_prep_time", type number}, {"temperature", type number}, {"rainfall", type number}, {"humidity", type number}, {"weather_condition", type text}, {"order_hour", Int64.Type}, {"traffic_score", type number}, {"average_speed", type number}, {"traffic_level", type text}, {"feedback_customer_rating", Int64.Type}, {"feedback_delivery_rating", Int64.Type}, {"feedback_food_rating", Int64.Type}, {"sentiment", type text}, {"has_review", Int64.Type}, {"distance_to_city_centre_km", type number}, {"is_cross_city", Int64.Type}, {"partner_tenure_days", Int64.Type}, {"discount_pct", type number}, {"order_minute", Int64.Type}, {"order_dayofweek", Int64.Type}, {"order_month", Int64.Type}, {"peak_hour", Int64.Type}, {"weekend_order", Int64.Type}, {"rain_impact", type text}, {"customer_tenure_days", Int64.Type}, {"restaurant_order_count", Int64.Type}, {"restaurant_popularity_rank", Int64.Type}, {"delivery_efficiency", type number}, {"average_rating", type number}, {"is_peak_and_rain", Int64.Type}, {"is_weekend_and_rain", Int64.Type}, {"coupon_used", Int64.Type}, {"is_late", Int64.Type}}, "en-US"),
				    WithTrafficSort = Table.AddColumn(Typed, "traffic_level_sort", each if [traffic_level] = "Low" then 1 else if [traffic_level] = "Moderate" then 2 else if [traffic_level] = "High" then 3 else if [traffic_level] = "Severe" then 4 else null, Int64.Type),
				    WithRainSort = Table.AddColumn(WithTrafficSort, "rain_impact_sort", each if [rain_impact] = "None" then 0 else if [rain_impact] = "Light" then 1 else if [rain_impact] = "Moderate" then 2 else if [rain_impact] = "Heavy" then 3 else null, Int64.Type)
				in
				    WithRainSort

	annotation PBI_ResultType = Table

