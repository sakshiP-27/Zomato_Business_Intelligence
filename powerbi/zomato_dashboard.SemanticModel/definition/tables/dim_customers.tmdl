	partition dim_customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customers_enriched.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Removed = Table.RemoveColumns(Promoted, {"age_was_missing", "phone_valid", "email_valid", "pincode_valid"}, MissingField.Ignore),
				    Typed = Table.TransformColumnTypes(Removed, {{"customer_id", type text}, {"name", type text}, {"age", Int64.Type}, {"gender", type text}, {"phone", type text}, {"email", type text}, {"city", type text}, {"state", type text}, {"pincode", type text}, {"registration_date", type date}, {"membership", type text}, {"total_orders", Int64.Type}, {"preferred_cuisine", type text}, {"orders_to_date", type date}, {"customer_lifetime_value", type number}, {"average_basket_value", type number}, {"first_order", type date}, {"last_order", type date}, {"days_since_last_order", Int64.Type}, {"order_frequency_30d", type number}, {"customer_segment", type text}}, "en-US")
				in
				    Typed

