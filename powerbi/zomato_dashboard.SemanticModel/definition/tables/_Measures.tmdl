	measure 'Churn Test Customers' = ```
				COUNTROWS ( ml_churn_scores_test )
			```
		formatString: '#,0'
		displayFolder: ML
		lineageTag: 727b2b30-3a90-5263-9602-54c8d9701ab8

	measure 'Saved Delivery RMSE' = ```
