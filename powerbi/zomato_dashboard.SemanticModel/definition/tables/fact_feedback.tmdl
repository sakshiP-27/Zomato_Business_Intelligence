	partition fact_feedback = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "customer_feedback.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Removed = Table.RemoveColumns(Promoted, {"review"}, MissingField.Ignore),
				    Typed = Table.TransformColumnTypes(Removed, {{"feedback_id", type text}, {"order_id", type text}, {"customer_rating", Int64.Type}, {"delivery_rating", Int64.Type}, {"food_rating", Int64.Type}, {"sentiment", type text}, {"has_review", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

