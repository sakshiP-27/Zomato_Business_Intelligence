	partition dim_promotions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "promotions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"promotion_id", type text}, {"coupon_code", type text}, {"discount_percentage", Int64.Type}, {"campaign_name", type text}, {"start_date", type date}, {"end_date", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

