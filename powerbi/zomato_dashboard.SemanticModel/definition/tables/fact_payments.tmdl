	partition fact_payments = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "payments.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"payment_id", type text}, {"order_id", type text}, {"payment_method", type text}, {"payment_status", type text}, {"transaction_id", type text}, {"payment_date", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

